---
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../layouts/Layout.astro';
import EntryCard from '../components/EntryCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Pagination from '../components/Pagination.astro';
import { getData, getCardItems, describeCategoryPath, getCategoryChildren } from '../lib/data';
import type { CardItem } from '../lib/data';

/**
 * One route for every registered link category, at ANY depth - "career", "technology/dev-tools",
 * "technology/dev-tools/kubernetes/documentation", and so on. There is no dedicated per-depth
 * route file (as there was for the old fixed two-level tree) because the tree's depth is now
 * unbounded: a category page shows its own DIRECT entries only (paginated), plus - when it has
 * any - its children as a clickable grid, exactly like a folder view. A leaf category (no
 * children) just shows entries.
 *
 * More specific static routes (career/companies/**, entry/[slug], browse, search, ...) always
 * win over this catch-all, so there is no collision with them.
 */
export const getStaticPaths = (async () => {
  const PAGE_SIZE = 24;
  const [data, items] = await Promise.all([getData(), getCardItems()]);

  const byExactPath = new Map<string, CardItem[]>();
  for (const item of items) {
    if (item.type !== 'link') continue;
    const bucket = byExactPath.get(item.group);
    if (bucket) bucket.push(item);
    else byExactPath.set(item.group, [item]);
  }

  return data.linkCategories.flatMap((cat) => {
    const categoryPath = cat.data.parent ? `${cat.data.parent}/${cat.data.slug}` : cat.data.slug;
    const entries = byExactPath.get(categoryPath) ?? [];
    const pageCount = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));

    return Array.from({ length: pageCount }, (_, i) => {
      const segments = i === 0 ? categoryPath.split('/') : [...categoryPath.split('/'), String(i + 1)];
      return {
        params: { path: segments.join('/') },
        props: {
          categoryPath,
          pageIndex: i,
          pageCount,
          pageSize: PAGE_SIZE,
          pageEntries: entries.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE),
          total: entries.length,
        },
      };
    });
  });
}) satisfies GetStaticPaths;

const { categoryPath, pageIndex, pageCount, pageSize, pageEntries, total } = Astro.props;

const chain = await describeCategoryPath(categoryPath);
const leaf = chain.at(-1)!;
const children = await getCategoryChildren(categoryPath);

const base = `/${categoryPath}`;
const page: Page<CardItem> = {
  data: pageEntries,
  start: pageIndex * pageSize,
  end: pageIndex * pageSize + pageEntries.length - 1,
  size: pageSize,
  total,
  currentPage: pageIndex + 1,
  lastPage: pageCount,
  url: {
    current: pageIndex === 0 ? base : `${base}/${pageIndex + 1}`,
    first: base,
    last: pageCount > 1 ? `${base}/${pageCount}` : base,
    prev: pageIndex > 0 ? (pageIndex === 1 ? base : `${base}/${pageIndex}`) : undefined,
    next: pageIndex < pageCount - 1 ? `${base}/${pageIndex + 2}` : undefined,
  },
};

const pageLabel = pageIndex > 0 ? ` - page ${pageIndex + 1}` : '';
const description = `${leaf.name} in the sidequest directory - ${total} curated ${
  total === 1 ? 'entry' : 'entries'
}${pageLabel}.`;
const canonical = new URL(base, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${leaf.name} · sidequest`,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: total,
    itemListElement: pageEntries.map((item, i) => ({
      '@type': 'ListItem',
      position: page.start + i + 1,
      name: item.title,
      url: new URL(item.href, Astro.site).href,
    })),
  },
};
---

<Layout
  title={`${leaf.name}${pageLabel}`}
  description={description}
  canonical={pageIndex > 0 ? canonical : undefined}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap page">
    <Breadcrumbs
      items={chain.map((c, i) => (i === chain.length - 1 ? { label: c.name } : { label: c.name, href: `/${c.path}` }))}
    />

    <header class="page-head" data-pagefind-ignore>
      <h1>{leaf.name}</h1>
      <p class="muted">
        {total} {total === 1 ? 'entry' : 'entries'}
        {pageCount > 1 && ` · page ${pageIndex + 1} of ${pageCount}`}
      </p>
    </header>

    {
      children.length > 0 && (
        <div class="children-grid">
          {children.map((child) => (
            <a class="child-tile" href={`/${child.path}`}>
              <span class="child-name">{child.name}</span>
              <span class="child-count">{child.count}</span>
            </a>
          ))}
        </div>
      )
    }

    {
      pageEntries.length > 0 ? (
        <>
          <div class="grid">
            {pageEntries.map((item) => <EntryCard item={item} hideGroup />)}
          </div>
          <Pagination page={page} />
        </>
      ) : (
        children.length === 0 && <p class="empty">No entries yet.</p>
      )
    }
  </div>
</Layout>

<style>
  .page {
    padding-block: var(--sp-6) var(--sp-8);
  }

  .page-head {
    margin-bottom: var(--sp-6);
  }

  .page-head h1 {
    font-size: var(--text-3xl);
  }

  .page-head p {
    margin-top: var(--sp-1);
  }

  .children-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--sp-3);
    margin-bottom: var(--sp-6);
  }

  .child-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--fg);
    font-weight: 550;
    font-size: var(--text-sm);
    transition: all 0.15s;
  }

  .child-tile:hover {
    border-color: var(--accent-border);
    background: var(--accent-subtle);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .child-count {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--fg-subtle);
    background: var(--bg-subtle);
    padding: 1px var(--sp-2);
    border-radius: var(--radius-full);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: var(--sp-4);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .children-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
