---
import type { CategoryNode } from '../lib/data';

interface Props {
  tree: CategoryNode[];
  currentParent: string | null;
  currentSub: string | null;
}

const { tree, currentParent, currentSub } = Astro.props;

// Categories with no entries yet still show in the menu (so the tree stays discoverable as it
// fills in) but sort to the bottom rather than crowding out populated ones.
const sorted = [...tree].sort((a, b) => {
  if (a.count === 0 && b.count > 0) return 1;
  if (b.count === 0 && a.count > 0) return -1;
  return 0;
});
---

<nav class="mega" aria-label="Link categories" data-pagefind-ignore data-mega-menu>
  <ul class="mega-bar">
    <li>
      <a href="/links" class="mega-trigger" aria-current={!currentParent ? 'page' : undefined}>
        All links
      </a>
    </li>
    {
      sorted.map((parent) => (
        <li class="mega-item" class:list={{ 'has-children': parent.children.length > 0 }}>
          <span class="mega-trigger-wrap">
            <a
              href={`/links/${parent.slug}`}
              class="mega-trigger"
              aria-current={currentParent === parent.slug && !currentSub ? 'page' : undefined}
            >
              {parent.name}
              <span class="count">{parent.count}</span>
            </a>
            {parent.children.length > 0 && (
              <button
                type="button"
                class="mega-toggle"
                aria-expanded="false"
                aria-label={`Show ${parent.name} subcategories`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
            )}
          </span>

          {parent.children.length > 0 && (
            <div class="mega-panel">
              <ul>
                {parent.children.map((child) => (
                  <li>
                    <a
                      href={`/links/${parent.slug}/${child.slug}`}
                      aria-current={
                        currentParent === parent.slug && currentSub === child.slug
                          ? 'page'
                          : undefined
                      }
                    >
                      {child.name}
                      <span class="count">{child.count}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .mega {
    position: sticky;
    top: 60px;
    z-index: 40;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .mega-bar {
    list-style: none;
    margin: 0;
    padding: 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    /* Deliberately not overflow-x: auto - setting overflow on only one axis forces the other
       axis to compute as "auto" too (a CSS spec quirk), which clips the absolutely-positioned
       dropdown panels below. Wrapping to a second line costs nothing here and avoids it
       entirely, so a many-category registry just grows the header by a row instead. */
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--sp-5);
  }

  .mega-item {
    position: relative;
    flex-shrink: 0;
  }

  .mega-trigger-wrap {
    display: flex;
    align-items: center;
  }

  .mega-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--sp-3) var(--sp-3);
    font-size: var(--text-sm);
    font-weight: 550;
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .mega-trigger:hover {
    color: var(--fg);
  }

  .mega-trigger[aria-current='page'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 650;
  }

  .mega-trigger .count {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    font-variant-numeric: tabular-nums;
  }

  .mega-toggle {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-left: -6px;
    border: none;
    background: none;
    color: var(--fg-subtle);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .mega-toggle:hover {
    background: var(--bg-subtle);
    color: var(--fg);
  }

  .mega-toggle svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s;
  }

  .mega-item[data-open='true'] .mega-toggle svg {
    transform: rotate(180deg);
  }

  .mega-panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: var(--sp-2);
    z-index: 41;
  }

  /* Desktop: hover or keyboard focus opens it; a click (data-open) also opens it, which is
     what makes this work for touch and mouse-without-hover alike. */
  @media (min-width: 901px) {
    .mega-item:hover .mega-panel,
    .mega-item:focus-within .mega-panel,
    .mega-item[data-open='true'] .mega-panel {
      display: block;
    }
  }

  .mega-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .mega-panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .mega-panel a:hover {
    background: var(--bg-subtle);
    color: var(--fg);
  }

  .mega-panel a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-subtle);
    font-weight: 600;
  }

  .mega-panel .count {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    font-variant-numeric: tabular-nums;
  }

  /* Mobile: no hover surface worth relying on, so the panel is tap-only and lays out inline
     (full width, static position) rather than floating over content. */
  @media (max-width: 900px) {
    .mega-bar {
      padding-block: var(--sp-2);
    }

    .mega-item[data-open='true'] .mega-panel {
      display: block;
      position: static;
      box-shadow: none;
      border: none;
      border-radius: 0;
      width: 100%;
      margin-top: var(--sp-1);
      padding-left: var(--sp-3);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mega-menu]').forEach((menu) => {
    const items = [...menu.querySelectorAll<HTMLElement>('.mega-item.has-children')];

    const closeAll = (except?: HTMLElement) => {
      for (const item of items) {
        if (item === except) continue;
        item.dataset.open = 'false';
        item.querySelector('.mega-toggle')?.setAttribute('aria-expanded', 'false');
      }
    };

    for (const item of items) {
      const toggle = item.querySelector<HTMLButtonElement>('.mega-toggle');
      toggle?.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = item.dataset.open === 'true';
        closeAll(isOpen ? undefined : item);
        item.dataset.open = String(!isOpen);
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
    }

    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) closeAll();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  });
</script>
