---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import EntryCard from '../../../components/EntryCard.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import Pagination from '../../../components/Pagination.astro';
import { getData, getCardItems, getCategoriesWithCounts } from '../../../lib/data';

export const getStaticPaths = (async ({ paginate }) => {
  const [data, items] = await Promise.all([getData(), getCardItems()]);

  const byCountry = new Map<string, typeof items>();
  for (const item of items) {
    if (item.type !== 'company') continue;
    const bucket = byCountry.get(item.group);
    if (bucket) bucket.push(item);
    else byCountry.set(item.group, [item]);
  }

  return data.countries.flatMap((country) => {
    const entries = byCountry.get(country.data.slug) ?? [];
    if (!entries.length) return [];

    return paginate(entries, {
      params: { country: country.data.slug },
      props: { countryName: country.data.name },
      pageSize: 24,
    });
  });
}) satisfies GetStaticPaths;

const { page, countryName } = Astro.props;
const { country } = Astro.params;

const countries = await getCategoriesWithCounts('companies');

const hiring = page.data.filter((c) => c.hiring_status === 'actively-hiring').length;
const pageLabel = page.currentPage > 1 ? ` — page ${page.currentPage}` : '';
const description = `Tech companies in ${countryName} — ${page.total} listed in the sidequest directory${pageLabel}.`;
const canonical = new URL(`/companies/${country}`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Companies in ${countryName} · sidequest`,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: page.total,
    itemListElement: page.data.map((item, i) => ({
      '@type': 'ListItem',
      position: page.start + i + 1,
      name: item.title,
      url: new URL(item.href, Astro.site).href,
    })),
  },
};
---

<Layout
  title={`Companies in ${countryName}${pageLabel}`}
  description={description}
  canonical={page.currentPage > 1 ? canonical : undefined}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
      <a href="/companies">Companies</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{countryName}</span>
    </nav>

    <header class="page-head" data-pagefind-ignore>
      <h1>{countryName}</h1>
      <p class="muted">
        {page.total} {page.total === 1 ? 'company' : 'companies'}
        {hiring > 0 && ` · ${hiring} actively hiring`}
        {page.lastPage > 1 && ` · page ${page.currentPage} of ${page.lastPage}`}
      </p>
    </header>

    <div class="layout">
      <CategoryNav
        categories={countries}
        base="/companies"
        current={country!}
        label="Countries"
      />

      <div>
        <div class="grid">
          {page.data.map((item) => <EntryCard item={item} hideGroup />)}
        </div>
        <Pagination page={page} />
      </div>
    </div>
  </div>
</Layout>

<style>
  .page {
    padding-block: var(--sp-6) var(--sp-8);
  }

  .crumbs {
    display: flex;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    color: var(--fg-subtle);
    margin-bottom: var(--sp-4);
  }

  .crumbs a {
    text-decoration: none;
  }

  .page-head {
    margin-bottom: var(--sp-6);
  }

  .page-head h1 {
    font-size: var(--text-3xl);
  }

  .page-head p {
    margin-top: var(--sp-1);
  }

  .layout {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: var(--sp-6);
    align-items: start;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: var(--sp-4);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
