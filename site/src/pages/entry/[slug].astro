---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Favicon from '../../components/Favicon.astro';
import Cover from '../../components/Cover.astro';
import EntryCard from '../../components/EntryCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getData, getCardItems, describeCategoryPath } from '../../lib/data';

export const getStaticPaths = (async () => {
  const data = await getData();
  return data.links.map((entry) => ({
    params: { slug: entry.id },
    props: { slug: entry.id },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.props;

const data = await getData();
const cards = await getCardItems();

const entry = data.linkBySlug.get(slug)!;
const { title, url, description, note, tags, priority, audience, added_by, date_added, legal_risk } =
  entry.data;

// Root-first chain of every registered ancestor, however deep - a leaf category page and this
// entry page share the same breadcrumb logic, since both ultimately describe a category path.
const chain = await describeCategoryPath(entry.data.category);
const leaf = chain.at(-1)!;

/**
 * Forward and reverse references, already unioned at build time - so an entry that never
 * declared `alternatives` itself still shows the entries that pointed at it.
 */
const alternativeSlugs = data.alternatives.get(slug) ?? [];
const alternatives = alternativeSlugs
  .map((s) => cards.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const declared = new Set(entry.data.alternatives ?? []);

const host = new URL(url).hostname;
const metaDescription =
  description ?? note ?? `${title} - a ${leaf.name} entry in the sidequest directory.`;

const breadcrumbItems: { label: string; href?: string }[] = [
  ...chain.map((c) => ({ label: c.name, href: `/${c.path}` })),
  { label: title },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: metaDescription,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: { '@type': 'WebSite', name: title, url },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.label,
      ...(item.href && { item: new URL(item.href, Astro.site).href }),
    })),
  },
};
---

<Layout title={title} description={metaDescription}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap page">
    <Breadcrumbs items={breadcrumbItems} />

    <Cover slug={slug} kind="links" alt={title} eager />

    <article data-pagefind-body>
      <header class="entry-head">
        <Favicon slug={slug} kind="links" title={title} size={52} eager />

        <div>
          <h1>{title}</h1>
          <a class="host" href={url} target="_blank" rel="noopener nofollow ugc">{host} ↗</a>
        </div>
      </header>

      {
        legal_risk && (
          <p class="legal-risk-banner" role="note">
            <span aria-hidden="true">⚠</span> May involve copyright infringement in your
            jurisdiction - included for reference, not an endorsement.
          </p>
        )
      }

      {description && <p class="lede">{description}</p>}

      <div class="actions" data-pagefind-ignore>
        <a class="btn primary" href={url} target="_blank" rel="noopener nofollow ugc">Visit {title}</a>
        <a
          class="btn"
          href={`https://github.com/ibtisam-iq/sidequest/blob/main/data/${entry.data.category}/${slug}.yaml`}
          target="_blank"
          rel="noopener"
        >
          View YAML
        </a>
      </div>

      {
        note && (
          <aside class="note">
            <span class="eyebrow">Why it's saved</span>
            <p>{note}</p>
          </aside>
        )
      }

      <dl class="facts" data-pagefind-ignore>
        <div>
          <dt>Category</dt>
          <dd>
            {chain.map((c, i) => (
              <>
                {i > 0 && ' / '}
                <a href={`/${c.path}`}>{c.name}</a>
              </>
            ))}
          </dd>
        </div>
        <div>
          <dt>Priority</dt>
          <dd><span class={`pill p-${priority}`}>{priority}</span></dd>
        </div>
        <div>
          <dt>Added</dt>
          <dd><time datetime={date_added}>{date_added}</time></dd>
        </div>
        {
          audience?.length && (
            <div>
              <dt>Audience</dt>
              <dd>{audience.map((a) => a.replace(/-/g, ' ')).join(', ')}</dd>
            </div>
          )
        }
        {
          added_by && (
            <div>
              <dt>Added by</dt>
              <dd>
                <a href={`https://github.com/${added_by}`} target="_blank" rel="noopener">
                  @{added_by}
                </a>
              </dd>
            </div>
          )
        }
      </dl>

      <div class="tags">
        {tags.map((tag) => <a class="tag" href={`/browse?tags=${tag}`}>#{tag}</a>)}
      </div>
    </article>

    {
      alternatives.length > 0 && (
        <section class="alts">
          <div class="section-head">
            <div>
              <h2>Alternatives to {title}</h2>
              <p class="muted">
                Similar entries in the directory. Links are two-way - an entry appears here
                whether it names {title} or {title} names it.
              </p>
            </div>
          </div>

          <div class="grid">
            {alternatives.map((alt) => (
              <div class="alt-cell">
                <EntryCard item={alt} />
                {!declared.has(alt.slug) && (
                  <span class="reverse" title={`${alt.title} lists ${title} as an alternative`}>
                    ↩ links back here
                  </span>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .page {
    padding-block: var(--sp-6) var(--sp-8);
    max-width: 860px;
  }

  .page :global(.cover) {
    border-radius: var(--radius-lg);
    margin-bottom: var(--sp-5);
  }

  .entry-head {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .host {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .host:hover {
    color: var(--accent);
  }

  .legal-risk-banner {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    background: var(--warning-bg);
    color: var(--warning);
    border: 1px solid var(--warning-border);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--fg-muted);
    margin-top: var(--sp-4);
  }

  .actions {
    display: flex;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--sp-2) var(--sp-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: all 0.15s;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }

  .btn.primary:hover {
    background: var(--accent-hover);
    color: var(--accent-fg);
  }

  .note {
    margin-top: var(--sp-6);
    padding: var(--sp-4);
    background: var(--accent-subtle);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius);
  }

  .note p {
    margin-top: var(--sp-1);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    padding-block: var(--sp-5);
    border-block: 1px solid var(--border);
  }

  dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
    font-weight: 600;
    margin-bottom: 2px;
  }

  dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .pill {
    display: inline-block;
    padding: 2px var(--sp-2);
    border-radius: var(--radius-full);
    font-weight: 600;
    text-transform: capitalize;
    font-size: var(--text-xs);
  }

  .p-high {
    background: var(--priority-high-bg);
    color: var(--priority-high);
  }
  .p-medium {
    background: var(--priority-medium-bg);
    color: var(--priority-medium);
  }
  .p-low {
    background: var(--priority-low-bg);
    color: var(--priority-low);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: var(--sp-1) var(--sp-3);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--fg-muted);
    text-decoration: none;
    transition: all 0.14s;
  }

  .tag:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .alts {
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
  }

  .alts h2 {
    font-size: var(--text-xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--sp-4);
  }

  .alt-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .reverse {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    padding-left: var(--sp-2);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
