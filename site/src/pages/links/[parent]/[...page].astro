---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import EntryCard from '../../../components/EntryCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Pagination from '../../../components/Pagination.astro';
import { getData, getCardItems } from '../../../lib/data';

export const getStaticPaths = (async ({ paginate }) => {
  const [data, items] = await Promise.all([getData(), getCardItems()]);

  // Group once, then iterate parents - O(n) overall. Filtering the full list per parent would
  // be O(n x parents) and is what makes builds crawl at scale.
  const byParent = new Map<string, typeof items>();
  for (const item of items) {
    if (item.type !== 'link') continue;
    const bucket = byParent.get(item.parentSlug);
    if (bucket) bucket.push(item);
    else byParent.set(item.parentSlug, [item]);
  }

  const topLevel = data.linkCategories.filter((c) => !c.data.parent);

  return topLevel.flatMap((parent) => {
    // A parent page shows everything filed under it, including its subcategories - only a
    // parent with genuinely zero entries anywhere under it is skipped.
    const entries = byParent.get(parent.data.slug) ?? [];
    if (!entries.length) return [];

    return paginate(entries, {
      params: { parent: parent.data.slug },
      props: { parentName: parent.data.name },
      pageSize: 24,
    });
  });
}) satisfies GetStaticPaths;

const { page, parentName } = Astro.props;
const { parent } = Astro.params;

const pageLabel = page.currentPage > 1 ? ` - page ${page.currentPage}` : '';
const description = `${parentName} in the sidequest directory - ${page.total} curated ${
  page.total === 1 ? 'entry' : 'entries'
}${pageLabel}.`;

// Later pages point their canonical at page 1 so pagination doesn't fragment ranking signals.
const canonical = new URL(`/links/${parent}`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${parentName} · sidequest`,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: page.total,
    itemListElement: page.data.map((item, i) => ({
      '@type': 'ListItem',
      position: page.start + i + 1,
      name: item.title,
      url: new URL(item.href, Astro.site).href,
    })),
  },
};
---

<Layout
  title={`${parentName}${pageLabel}`}
  description={description}
  canonical={page.currentPage > 1 ? canonical : undefined}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap page">
    <Breadcrumbs items={[{ label: 'Links', href: '/links' }, { label: parentName }]} />

    <header class="page-head" data-pagefind-ignore>
      <h1>{parentName}</h1>
      <p class="muted">
        {page.total} {page.total === 1 ? 'entry' : 'entries'}
        {page.lastPage > 1 && ` · page ${page.currentPage} of ${page.lastPage}`}
      </p>
    </header>

    <div class="grid">
      {page.data.map((item) => <EntryCard item={item} />)}
    </div>
    <Pagination page={page} />
  </div>
</Layout>

<style>
  .page {
    padding-block: var(--sp-6) var(--sp-8);
  }

  .page-head {
    margin-bottom: var(--sp-6);
  }

  .page-head h1 {
    font-size: var(--text-3xl);
  }

  .page-head p {
    margin-top: var(--sp-1);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: var(--sp-4);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
