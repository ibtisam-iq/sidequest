---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../../layouts/Layout.astro';
import Favicon from '../../../../components/Favicon.astro';
import { getData } from '../../../../lib/data';

export const getStaticPaths = (async () => {
  const data = await getData();
  return data.companies.map((entry) => ({
    params: { country: entry.data.country, slug: entry.id },
    props: { slug: entry.id },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.props;

const data = await getData();
const entry = data.companies.find((c) => c.id === slug)!;
const {
  name,
  website,
  country,
  industry,
  size,
  remote_policy,
  hiring_status,
  careers_url,
  rating,
  tags,
  date_added,
} = entry.data;

const countryName = data.countries.find((c) => c.data.slug === country)?.data.name ?? country;
const host = new URL(website).hostname;
const humanize = (v: string) => v.replace(/-/g, ' ');

const metaDescription =
  rating ?? `${name} — a ${humanize(industry)} company in ${countryName}, listed in the sidequest directory.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name,
  url: website,
  description: metaDescription,
  address: { '@type': 'PostalAddress', addressCountry: countryName },
  ...(careers_url && { sameAs: [careers_url] }),
};
---

<Layout title={name} description={metaDescription}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
      <a href="/companies">Companies</a>
      <span aria-hidden="true">/</span>
      <a href={`/companies/${country}`}>{countryName}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{name}</span>
    </nav>

    <article data-pagefind-body>
      <header class="entry-head">
        <Favicon url={website} title={name} size={52} eager />
        <div>
          <h1>{name}</h1>
          <a class="host" href={website} rel="noopener nofollow ugc">{host} ↗</a>
        </div>
        {
          hiring_status === 'actively-hiring' && (
            <span class="hiring-badge">
              <span class="dot" aria-hidden="true" /> Actively hiring
            </span>
          )
        }
      </header>

      {rating && <p class="lede">{rating}</p>}

      {/*
        Pagefind concatenates <dt>/<dd> text without separators, which produces excerpts like
        "CountryPakistan. Industryfintech". So the fact list below is excluded from the index and
        this sentence is indexed in its place — it keeps country/industry/policy searchable while
        reading as real prose in a result excerpt.
      */}
      <p class="sr-only">
        {name} is a {humanize(industry)} company based in {countryName}.
        {size && ` Size: ${size}.`}
        {remote_policy && remote_policy !== 'unknown' && ` Remote policy: ${remote_policy}.`}
        {hiring_status === 'actively-hiring' && ' Currently hiring.'}
      </p>

      <div class="actions" data-pagefind-ignore>
        <a class="btn primary" href={website} rel="noopener nofollow ugc">Visit website</a>
        {careers_url && <a class="btn" href={careers_url} rel="noopener nofollow ugc">View careers</a>}
        <a
          class="btn"
          href={`https://github.com/ibtisam-iq/sidequest/blob/main/data/companies/${country}/${slug}.yaml`}
          rel="noopener"
        >
          View YAML
        </a>
      </div>

      <dl class="facts" data-pagefind-ignore>
        <div>
          <dt>Country</dt>
          <dd><a href={`/companies/${country}`}>{countryName}</a></dd>
        </div>
        <div>
          <dt>Industry</dt>
          <dd>{humanize(industry)}</dd>
        </div>
        {
          size && (
            <div>
              <dt>Size</dt>
              <dd>{size}</dd>
            </div>
          )
        }
        {
          remote_policy && (
            <div>
              <dt>Remote policy</dt>
              <dd>{remote_policy}</dd>
            </div>
          )
        }
        {
          hiring_status && (
            <div>
              <dt>Hiring</dt>
              <dd>{humanize(hiring_status)}</dd>
            </div>
          )
        }
        <div>
          <dt>Added</dt>
          <dd><time datetime={date_added}>{date_added}</time></dd>
        </div>
      </dl>

      {
        tags?.length && (
          <div class="tags">
            {tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )
      }
    </article>
  </div>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .page {
    padding-block: var(--sp-6) var(--sp-8);
    max-width: 860px;
  }

  .crumbs {
    display: flex;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    color: var(--fg-subtle);
    margin-bottom: var(--sp-5);
    flex-wrap: wrap;
  }

  .crumbs a {
    text-decoration: none;
  }

  .entry-head {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }


  h1 {
    font-size: var(--text-3xl);
  }

  .host {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .host:hover {
    color: var(--accent);
  }

  .hiring-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-left: auto;
    padding: var(--sp-1) var(--sp-3);
    background: var(--hiring-bg);
    color: var(--hiring);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--fg-muted);
    margin-top: var(--sp-4);
  }

  .actions {
    display: flex;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--sp-2) var(--sp-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: all 0.15s;
  }

  .btn:hover {
    border-color: var(--company);
    color: var(--company);
  }

  .btn.primary {
    background: var(--company);
    border-color: var(--company);
    color: var(--bg);
  }

  .btn.primary:hover {
    opacity: 0.9;
    color: var(--bg);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    padding-block: var(--sp-5);
    border-block: 1px solid var(--border);
  }

  dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
    font-weight: 600;
    margin-bottom: 2px;
  }

  dd {
    margin: 0;
    font-size: var(--text-sm);
    text-transform: capitalize;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: var(--sp-1) var(--sp-3);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--fg-muted);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: var(--text-2xl);
    }
    .hiring-badge {
      margin-left: 0;
    }
  }
</style>
